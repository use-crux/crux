    "fumadocs-ui": "^16.9.0",
    "next": "^16.2.6",
    "posthog-js": "^1.395.0",
    "posthog-node": "^5.38.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "twoslash": "^0.3.8"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
