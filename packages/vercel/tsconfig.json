{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vitest"],
    "paths": {
      "@use-crux/core": ["../core/src/index.ts"],
      "@use-crux/vercel": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
