{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@use-crux/core": ["../core/src/index.ts"],
      "@use-crux/core/runtime": ["../core/src/runtime/public.ts"],
      "@use-crux/core/runtime/next": ["../core/src/runtime/next.ts"],
      "@use-crux/core/runtime/testing": ["../core/src/runtime/testing/index.ts"],
      "@use-crux/core/*": ["../core/src/*"],
      "@use-crux/indexer": ["../indexer/src/index.ts"],
      "@use-crux/indexer/*": ["../indexer/src/*"]
    }
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
