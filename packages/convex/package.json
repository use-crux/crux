{
  "name": "@crux/convex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./swarm": {
      "types": "./swarm.ts",
      "import": "./swarm.ts"
    },
    "./agent": {
      "types": "./agent.ts",
      "import": "./agent.ts"
    },
    "./workspace": {
      "types": "./workspace.ts",
      "import": "./workspace.ts"
    },
    "./bridge": {
      "types": "./bridge.ts",
      "import": "./bridge.ts"
    },
    "./observability": {
      "types": "./observability.ts",
      "import": "./observability.ts"
    },
    "./server": {
      "types": "./server.ts",
      "import": "./server.ts"
    },
    "./convex.config": {
      "types": "./src/component/convex.config.ts",
