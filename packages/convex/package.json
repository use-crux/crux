{
  "name": "@use-crux/convex",
  "version": "0.3.0",
  "description": "Convex runtime profile for Crux storage, agent integration, and React transport.",
  "keywords": [
    "convex",
    "ai",
    "llm",
    "agents",
    "memory",
    "rag",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./swarm": {
      "types": "./swarm.ts",
      "import": "./swarm.ts"
    },
    "./agent": {
      "types": "./agent.ts",
      "import": "./agent.ts"
    },
    "./context": {
      "types": "./context.ts",
      "import": "./context.ts"
    },
    "./memory": {
      "types": "./memory.ts",
      "import": "./memory.ts"
    },
    "./react": {
      "types": "./react.ts",
      "import": "./react.ts"
    },
    "./skill": {
      "types": "./skill.ts",
      "import": "./skill.ts"
    },
    "./tools": {
      "types": "./tools.ts",
      "import": "./tools.ts"
    },
    "./runtime": {
      "types": "./runtime.ts",
      "import": "./runtime.ts"
    },
    "./runtime-bridge": {
      "types": "./runtime-bridge.ts",
      "import": "./runtime-bridge.ts"
    },
    "./workspace": {
      "types": "./workspace.ts",
      "import": "./workspace.ts"
    },
    "./bridge": {
      "types": "./bridge.ts",
      "import": "./bridge.ts"
    },
    "./observability": {
      "types": "./observability.ts",
      "import": "./observability.ts"
    },
    "./server": {
      "types": "./server.ts",
      "import": "./server.ts"
    },
    "./convex.config": {
      "types": "./src/component/convex.config.ts",
      "import": "./src/component/convex.config.ts"
    },
    "./_generated/component.js": {
      "types": "./src/component/_generated/component.ts"
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@use-crux/ai": "workspace:*",
    "@use-crux/core": "workspace:*",
    "@use-crux/react": "workspace:*",
    "zod": "^4.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.12.4",
    "convex-test": "^0.0.54",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@convex-dev/agent": ">=0.6.1",
    "convex": ">=1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@convex-dev/agent": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/convex"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/storage/convex"
}
