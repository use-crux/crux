{
  "name": "@use-crux/convex",
  "version": "0.8.0",
  "description": "Convex runtime profile for Crux storage, agent integration, and React transport.",
  "keywords": [
    "convex",
    "ai",
    "llm",
    "agents",
    "memory",
    "rag",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./swarm": {
      "types": "./src/swarm.ts",
      "import": "./src/swarm.ts"
    },
    "./agent": {
      "types": "./src/agent.ts",
      "import": "./src/agent.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "import": "./src/context.ts"
    },
    "./memory": {
      "types": "./src/memory.ts",
      "import": "./src/memory.ts"
    },
    "./retrieval": {
      "types": "./src/retrieval.ts",
      "import": "./src/retrieval.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    },
    "./skill": {
      "types": "./src/skill.ts",
      "import": "./src/skill.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "import": "./src/tools.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./src/runtime.ts"
    },
    "./runtime/node": {
      "types": "./src/runtime-node.ts",
      "import": "./src/runtime-node.ts"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "import": "./src/workspace.ts"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "import": "./src/bridge.ts"
    },
    "./observability": {
      "types": "./src/observability.ts",
      "import": "./src/observability.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./convex.config": {
      "types": "./src/component/convex.config.ts",
      "import": "./src/component/convex.config.ts"
    },
    "./_generated/component.js": {
      "types": "./src/component/_generated/component.ts"
    },
    "./skill/node": {
      "types": "./src/skill-node.ts",
      "import": "./src/skill-node.ts"
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@use-crux/ai": "workspace:*",
    "@use-crux/core": "workspace:*",
    "@use-crux/react": "workspace:*",
    "zod": "^4.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:observability:runtime": "vitest run __tests__/server.test.ts __tests__/server-flow.test.ts __tests__/swarm.test.ts __tests__/agent-lifecycle-observe.test.ts __tests__/runtime-engine-handlers.test.ts __tests__/observability-runtime.test.ts __tests__/observability-bundle.test.ts __tests__/profile-lifecycle-observability.test.ts"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.12.4",
    "convex-test": "^0.0.54",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@convex-dev/agent": ">=0.6.1",
    "convex": ">=1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@convex-dev/agent": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/convex"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/storage/convex"
}
