{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest"],
    "paths": {
      "@use-crux/core": ["../core/index.ts"],
      "@use-crux/core/runtime": ["../core/runtime/public.ts"],
      "@use-crux/core/*": ["../core/*"],
      "@use-crux/react": ["../react/src/index.ts"],
      "@use-crux/react/*": ["../react/src/*"]
    }
  },
  "include": ["*.ts", "src/**/*.ts", "__tests__/**/*.ts", "__tests__/**/*.tsx", "__type_tests__/**/*.ts"],
  "exclude": ["node_modules"]
}
