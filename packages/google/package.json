{
  "name": "@use-crux/google",
  "version": "0.4.0",
  "description": "Google GenAI (Gemini) adapter for Crux — run Crux prompts and agents against Google models.",
  "keywords": [
    "ai",
    "llm",
    "google",
    "gemini",
    "genai",
    "adapter",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@use-crux/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@google/genai": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/google"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/adapters/google"
