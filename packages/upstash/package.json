{
  "name": "@use-crux/upstash",
  "version": "0.4.0",
  "description": "Upstash VectorStore and Redis RecordStore adapters for Crux storage.",
  "license": "Apache-2.0",
  "private": true,
  "author": "Crux",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "rag",
    "upstash",
    "vector",
    "redis",
    "semantic-cache",
    "crux"
  ],
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./runtime": {
      "types": "./runtime.ts",
      "import": "./runtime.ts",
      "require": "./runtime.ts"
    }
  },
  "dependencies": {
    "@use-crux/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@upstash/qstash": "^2.11.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@upstash/qstash": "^2.11.1",
    "@upstash/redis": "^1.0.0",
    "@upstash/vector": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/qstash": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/upstash"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/storage/upstash"
}
