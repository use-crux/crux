{
  "name": "@use-crux/ingest",
  "version": "0.7.0",
  "description": "Source loaders for Crux — turn text, files, and URLs into IngestDocument streams for indexing.",
  "keywords": [
    "ai",
    "rag",
    "ingest",
    "loaders",
    "documents",
    "indexing",
    "crux"
  ],
  "author": "Crux",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./files": {
      "types": "./src/files.ts",
      "import": "./src/files.ts"
    },
    "./urls": {
      "types": "./src/urls.ts",
      "import": "./src/urls.ts"
    }
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.12.0",
    "@use-crux/core": "workspace:*",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "pdfjs-dist": "^5.0.0",
    "ssf": "^0.11.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "docx": "^9.6.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/ingest"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/ingest"
}
