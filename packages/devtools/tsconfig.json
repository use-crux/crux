{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./ui/src/*"],
      "@use-crux/core": ["../core/index.ts"],
      "@use-crux/core/*": ["../core/*"],
      "@use-crux/indexer": ["../indexer/index.ts"],
      "@use-crux/indexer/*": ["../indexer/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "bin/**/*.ts",
    "bin/**/*.tsx",
    "lib/**/*.ts",
    "ink/**/*.ts",
    "ink/**/*.tsx",
    "ui/src/**/*.ts",
    "ui/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
