{
  "name": "@use-crux/devtools",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Web UI for Crux local devtools",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:ui",
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev:server": "node ../local/npm/local/bin/crux.cjs dev",
    "build": "pnpm run build:workers && vite build --config ui/vite.config.ts",
    "start": "node ../local/npm/local/bin/crux.cjs dev",
    "typecheck": "tsc --noEmit",
    "build:workers": "node ./scripts/build-workers.mjs",
    "perf:indexer": "tsx ./scripts/indexer-benchmark.ts",
    "perf:indexer-static": "tsx ./scripts/indexer-static-benchmark.ts",
    "perf:indexer-static:extensions": "tsx ./scripts/indexer-static-extension-guard.ts",
    "perf:indexer:watch": "tsx ./scripts/indexer-watch-benchmark.ts",
    "parity:indexer-static": "tsx ./scripts/indexer-static-parity.ts",
    "parity:indexer-semantic": "tsx ./lib/indexer-semantic-parity.ts",
    "check:ui-architecture": "node ./scripts/check-ui-architecture.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@use-crux/core": "workspace:*",
    "@use-crux/indexer": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.13",
    "@tanstack/react-query-devtools": "^5.100.13",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.0",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "open": "^11.0.0",
    "radix-ui": "^1.4.3",
    "react-resizable-panels": "^4.11.1",
    "recharts": "2.15.4",
    "shiki": "^3.23.0",
    "sirv": "^3.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tinyglobby": "^0.2.16",
    "tokenlens": "^1.3.1",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.20.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ngrok/ngrok": ">=1.0.0",
    "localtunnel": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@ngrok/ngrok": {
      "optional": true
    },
    "localtunnel": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/crux-core/devtools"
}
