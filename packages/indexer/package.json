{
  "name": "@use-crux/indexer",
  "version": "0.4.0",
  "description": "Project Index and source-intelligence workers for Crux — indexing, extensions, and source resolution.",
  "keywords": [
    "ai",
    "rag",
    "indexing",
    "source-intelligence",
    "ast",
    "crux"
  ],
  "author": "Crux",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./extensions": {
      "types": "./src/extensions.ts",
      "import": "./src/extensions.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts"
    },
    "./host/static-index": {
      "types": "./src/host/static-index.ts",
      "import": "./src/host/static-index.ts"
    },
    "./host/semantic": {
      "types": "./src/host/semantic.ts",
      "import": "./src/host/semantic.ts"
    },
    "./host/runtime": {
      "types": "./src/host/runtime.ts",
      "import": "./src/host/runtime.ts"
    },
    "./host/static-compat": {
      "types": "./src/host/static-compat.ts",
      "import": "./src/host/static-compat.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    },
    "./contracts/worker-events": {
      "types": "./src/contracts/worker-events/index.ts",
      "import": "./src/contracts/worker-events/index.ts"
    },
    "./contracts/static-index": {
      "types": "./src/contracts/static-index/index.ts",
      "import": "./src/contracts/static-index/index.ts"
    },
    "./contracts/static-syntax": {
      "types": "./src/contracts/static-syntax/index.ts",
      "import": "./src/contracts/static-syntax/index.ts"
    },
    "./contracts/semantic": {
      "types": "./src/contracts/semantic/index.ts",
      "import": "./src/contracts/semantic/index.ts"
    },
    "./contracts/parity": {
      "types": "./src/contracts/parity/index.ts",
      "import": "./src/contracts/parity/index.ts"
    },
    "./source-resolver": {
      "types": "./src/source-resolver.ts",
      "import": "./src/source-resolver.ts"
    }
  },
  "scripts": {
    "check:contracts": "node ../../scripts/check-indexer-contracts.mjs",
    "test": "pnpm run check:contracts && vitest run --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@use-crux/core": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.22.3",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@use-crux/postgres": "workspace:*",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.22.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/indexer"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/indexer"
}
