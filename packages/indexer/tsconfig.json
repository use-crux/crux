{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest"],
    "paths": {
      "@use-crux/core": ["../core/index.ts"],
      "@use-crux/core/runtime": ["../core/runtime/public.ts"],
      "@use-crux/core/runtime/next": ["../core/runtime/next.ts"],
      "@use-crux/core/runtime/testing": ["../core/runtime/testing/index.ts"],
      "@use-crux/core/*": ["../core/*"]
    }
  },
  "include": [
    "index.ts",
    "extensions.ts",
    "testing.ts",
    "host/**/*.ts",
    "contracts/**/*.ts",
    "indexer/**/*.ts",
    "source-resolver.ts",
    "source-resolver/**/*.ts",
    "__tests__/**/*.ts"
  ]
}
