{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest"],
    "paths": {
      "@use-crux/core": ["../core/src/index.ts"],
      "@use-crux/core/runtime": ["../core/src/runtime/public.ts"],
      "@use-crux/core/runtime/next": ["../core/src/runtime/next.ts"],
      "@use-crux/core/runtime/testing": ["../core/src/runtime/testing/index.ts"],
      "@use-crux/core/*": ["../core/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "__tests__/**/*.ts"
  ]
}
