        ],
        "rust": ["crates/protocol/src/static_index.rs", "crates/static-compiler/src/shared_fixtures_tests.rs"]
      },
      "fixtureCoverage": "Shared Static Index protocol and identity fixtures are decoded by TypeScript, Go, and Rust for every method, cache-sensitive identity owner, worker-error, and invalid-stream case.",
      "jsonBoundaries": [
        "Go keeps cacheInputs, extensionHost, diagnostics, facts, and extensionEvidenceInterests as json.RawMessage at extension/runtime boundaries.",
        "Rust keeps diagnostics, facts, extension evidence jobs, cache inputs, and finalizer events as serde_json::Value until TypeScript-owned contract validation classifies them."
