      ],
      "fixtures": ["packages/indexer/contracts/fixtures/semantic-evidence.json"],
      "mirrors": {
        "go": [],
        "rust": []
      },
      "fixtureCoverage": "A TS-only semantic evidence fixture covers definitions, relations, source refs, diagnostics, lint findings, and degraded/unsupported cases; Go hosts consume Project Index patch events today and Rust has no semantic evidence mirror.",
      "jsonBoundaries": [
        "Go and Rust do not mirror Semantic Evidence structs today; Go consumes the Project Index worker event protocol after TypeScript projection."
      ]
    }
  ]
}
