        ]
      },
      "fixtureCoverage": "Shared static syntax fixtures cover imports, call matches, object values, native fact packets, constructor matches, callback summaries, and parser diagnostics across TypeScript, Go, and Rust.",
      "jsonBoundaries": [
        "Static syntax records intentionally preserve extension-shaped native fact packets as JSON-safe payloads until TypeScript contract validation classifies them."
      ]
