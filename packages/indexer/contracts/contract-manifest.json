{
  "schemaVersion": 1,
  "protocolVersions": {
    "projectIndexWorkerEvents": 2,
    "staticIndexCompiler": 2
  },
  "protocolVersionChecks": [
    {
      "version": "projectIndexWorkerEvents",
      "runtime": "typescript",
      "path": "packages/indexer/indexer/worker-protocol/types.ts",
      "pattern": "PROJECT_INDEX_WORKER_PROTOCOL_VERSION\\s*=\\s*(\\d+)"
    },
    {
      "version": "projectIndexWorkerEvents",
      "runtime": "go",
      "path": "packages/local/internal/projectindex/wire/worker_protocol.go",
      "pattern": "projectIndexWorkerProtocolVersion\\s*=\\s*(\\d+)"
    },
    {
      "version": "projectIndexWorkerEvents",
      "runtime": "rust",
      "path": "crates/static-compiler/src/finalizer/events.rs",
      "pattern": "\\\"protocolVersion\\\"\\s*:\\s*(\\d+)"
    },
    {
      "version": "staticIndexCompiler",
      "runtime": "typescript",
      "path": "packages/indexer/indexer/static-index/protocol/identity.ts",
      "pattern": "STATIC_INDEX_COMPILER_PROTOCOL_VERSION\\s*=\\s*(\\d+)"
    },
    {
      "version": "staticIndexCompiler",
      "runtime": "go",
      "path": "packages/local/internal/projectindex/staticindex/protocol/types.go",
      "pattern": "Version\\s*=\\s*(\\d+)"
    },
    {
      "version": "staticIndexCompiler",
      "runtime": "rust",
      "path": "crates/protocol/src/static_index.rs",
      "pattern": "STATIC_INDEX_PROTOCOL_VERSION:\\s*u8\\s*=\\s*(\\d+)"
    }
  ],
  "groups": [
    {
      "id": "worker-events",
      "label": "Project Index worker events",
      "description": "Versioned NDJSON event stream for Project Index patch facts, source profiles, and artifacts.",
      "mirrorStatus": "checked-mirror",
      "canonical": [
        "packages/indexer/contracts/worker-events/schema.ts",
        "packages/indexer/contracts/worker-events/fixtures.ts",
        "packages/indexer/indexer/worker-protocol/types.ts",
        "packages/indexer/indexer/worker-protocol/patch-events.ts",
        "packages/indexer/indexer/worker-protocol/artifact-events.ts",
        "packages/indexer/indexer/worker-protocol/source-profile-events.ts"
      ],
      "fixtures": [
        "packages/indexer/contracts/fixtures/worker-events.json",
        "packages/indexer/contracts/fixtures/worker-event-cases.json"
      ],
      "mirrors": {
        "go": [
          "packages/local/internal/projectindex/wire/worker_protocol.go",
          "packages/local/internal/projectindex/wire/worker_protocol_facts.go",
          "packages/local/internal/projectindex/wire/worker_protocol_source_profile.go",
          "packages/local/internal/projectindex/wire/worker_artifact.go",
          "packages/local/internal/projectindex/wire/shared_fixtures_test.go"
        ],
        "rust": [
          "crates/protocol/src/worker.rs",
          "crates/static-compiler/src/finalizer/events.rs",
          "crates/static-compiler/src/shared_fixtures_tests.rs"
        ]
      },
      "fixtureCoverage": "Shared worker-event fixtures are consumed by TypeScript, Go, and Rust for success, artifact, phase-error, and out-of-order stream cases.",
      "jsonBoundaries": [
        "Go decodes worker event headers and artifact payloads from json.RawMessage before event-type validation.",
        "Rust finalizer event emission uses serde_json::Value for Project Index facts because fact payloads are typed by the TypeScript contract spine."
      ]
    },
    {
      "id": "static-syntax-records",
      "label": "Static Syntax records",
      "description": "Parser evidence records emitted before source-only Project Index projection.",
      "mirrorStatus": "checked-mirror",
      "canonical": [
        "packages/indexer/contracts/static-syntax/schema.ts",
        "packages/indexer/indexer/static-index/syntax/record/types.ts",
        "packages/indexer/indexer/static-index/syntax/record/value-types.ts",
