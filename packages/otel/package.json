{
  "name": "@use-crux/otel",
  "version": "0.2.0",
  "description": "OpenTelemetry observability plugin for Crux — emit spans and attributes for prompts, agents, and flows.",
  "keywords": [
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "ai",
    "llm",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    }
  },
  "dependencies": {
    "@use-crux/core": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@types/node": "^24.12.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/otel"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/plugins/otel"
}
