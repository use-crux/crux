{
  "name": "@use-crux/mcp",
  "version": "0.5.0",
  "description": "Portable Model Context Protocol tool sources for Crux.",
  "keywords": [
    "ai",
    "llm",
    "mcp",
    "model-context-protocol",
    "tools",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing/vitest": {
      "types": "./src/testing/vitest.ts",
      "import": "./src/testing/vitest.ts"
    }
  },
  "imports": {
    "#ai-sdk-stdio": {
      "node": "./src/ai-sdk/stdio-node.ts",
      "default": "./src/ai-sdk/stdio-portable.ts"
    },
    "#official-stdio": {
      "node": "./src/official-client/stdio-node.ts",
      "default": "./src/official-client/stdio-portable.ts"
    }
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.61",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@use-crux/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/mcp"
}
