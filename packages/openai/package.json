{
  "name": "@use-crux/openai",
  "version": "0.2.0",
  "description": "OpenAI SDK adapter for Crux — run Crux prompts and agents against OpenAI models.",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "gpt",
    "adapter",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@use-crux/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "openai": "^5.0.0||^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/openai"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/adapters/openai"
