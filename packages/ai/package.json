{
  "name": "@use-crux/ai",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Vercel AI SDK adapter for Crux — run Crux prompts, agents, and flows against any AI SDK model (generate & stream).",
  "keywords": [
    "ai",
    "llm",
    "vercel-ai-sdk",
    "adapter",
    "streaming",
    "crux"
  ],
  "author": "Crux",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./agent": {
      "types": "./agent/index.ts",
      "import": "./agent/index.ts",
      "require": "./agent/index.ts"
    },
    "./stream": {
      "types": "./stream/index.ts",
      "import": "./stream/index.ts",
      "require": "./stream/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@use-crux/core": "workspace:*",
    "@use-crux/react": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://github.com/use-crux/crux/tree/main/packages/ai#readme"
}
