{
  "name": "@use-crux/ai",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "description": "Vercel AI SDK adapter for Crux — run Crux prompts, agents, and flows against any AI SDK model (generate & stream).",
  "keywords": [
    "ai",
    "llm",
    "vercel-ai-sdk",
    "adapter",
    "streaming",
    "crux"
  ],
  "author": "Crux",
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts"
    },
    "./stream": {
      "types": "./src/stream/index.ts",
      "import": "./src/stream/index.ts"
    },
    "./transcription/node": {
      "types": "./src/transcription/node.ts",
      "import": "./src/transcription/node.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@use-crux/core": "workspace:*",
    "@use-crux/react": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@use-crux/mcp": "workspace:^0.5.0 || ^0.6.0",
    "ai": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@use-crux/mcp": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/reference/adapters/ai"
}
