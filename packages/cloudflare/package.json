{
  "name": "@use-crux/cloudflare",
  "version": "0.5.0",
  "description": "Cloudflare Workers and Durable Object runtime host for Crux.",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "ai",
    "evals",
    "crux"
  ],
  "license": "Apache-2.0",
  "author": "Crux",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@use-crux/core": "workspace:*"
  },
  "scripts": {
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260710.1",
    "@types/node": "^24.12.4",
    "esbuild": "^0.28.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.110.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-crux/crux.git",
    "directory": "packages/cloudflare"
  },
  "bugs": {
    "url": "https://github.com/use-crux/crux/issues"
  },
  "homepage": "https://cruxjs.dev/docs/guides/evals/runtime-hosts#cloudflare-workers"
